# ============================================================
#  Ine Mebel Jepara - contoh environment variable
#  Salin jadi .env untuk lokal, atau isi di dashboard Vercel.
#  JANGAN commit .env asli (sudah masuk .gitignore).
# ============================================================

# --- Database (Neon / Postgres) ---
# Dari Neon: Connect -> connection string. Wajib ada sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Server ---
# PORT otomatis diisi oleh hosting. Untuk lokal biarkan kosong.
# APP_HOST=0.0.0.0
# APP_PORT=5000
APP_DEBUG=0

# --- Autentikasi admin (WAJIB diisi saat deploy) ---
AUTH_ENABLED=1
# Buat nilai acak, contoh: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Isi di dashboard Vercel -> Environment Variables. JANGAN commit nilai asli ke Git.
AUTH_SECRET=ganti-dengan-string-acak-panjang
TOKEN_TTL=28800

# Admin default yang dibuat otomatis saat tabel admin_users masih kosong.
# Isi di dashboard Vercel -> Environment Variables.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=ganti-password-kuat-ini

# --- Upload foto produk ---
# Di Vercel disk hanya baca: upload file baru tidak tersimpan.
# Foto yang sudah ada di folder img/ tetap tampil.
UPLOAD_DIR=img
UPLOAD_URL=img
MAX_UPLOAD_MB=5
